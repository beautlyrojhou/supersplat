{
  "name": "supersplat",
  "version": "1.0.0",
  "description": "3D Gaussian Splat Editor built on PlayCanvas",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:prod": "NODE_ENV=production rollup -c",
    "watch": "rollup -c --watch",
    "serve": "node copy-and-watch.mjs",
    "dev": "npm run watch & npm run serve",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playcanvas": "^1.68.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "rollup": "^4.12.0",
    "rollup-plugin-scss": "^4.0.0",
    "sass": "^1.71.1",
    "serve": "^14.2.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
